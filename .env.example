# Local Docker Compose database settings.
# MYSQL_PORT is 3307 because port 3306 may already be used by a local MySQL installation.
MYSQL_DATABASE=communication_feedback_db
MYSQL_USER=group8
MYSQL_PASSWORD=replace-with-a-local-app-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-db-password
APP_PORT=8082
MYSQL_PORT=3307

# Group 5 RS256 token validation settings.
GROUP5_JWKS_URL=https://university-identity-service.onrender.com/.well-known/jwks.json
GROUP5_JWT_ISSUER=university-identity-service
GROUP5_JWT_AUDIENCE=university-services-platform
# Optional Group 5 machine-to-machine credential for recipient lookups on /api/notifications/trigger
# (those calls carry no user token). Without it, triggered recipients are accepted unverified.
# Use a dedicated credential supplied by Group 5, never a personal login token.
USER_DIRECTORY_ACCESS_TOKEN=
NOTIFICATIONS_SERVICE_KEY=replace-with-the-shared-event-service-key

# Optional local service URLs. Leave blank when running without those services.
USER_DIRECTORY_BASE_URL=https://university-identity-service.onrender.com
# Group 5's current recipient-validation endpoint.
USER_DIRECTORY_ELIGIBILITY_PATH=/api/v1/validation/users/{userId}/eligibility
# Leave blank to accept any eligible active role. Set one role, such as STUDENT,
# only when this service should accept that role exclusively.
USER_DIRECTORY_REQUIRED_ROLE=
FACILITY_DIRECTORY_BASE_URL=
# Group 7 work-order-service: service-request feedback needs a RESOLVED/CLOSED request owned by the rater.
GROUP7_FEEDBACK_BASE_URL=
# Group 8 event-service: event feedback needs a CONFIRMED registration for the event.
EVENT_SERVICE_BASE_URL=

# Render/Aiven deployment values.
# These are entered in Render's Environment Variables section, not used by the
# local Docker Compose database above. Never commit a real password here.
# DB_URL=jdbc:mysql://mysql-268a61e8-notification-and-feedback.a.aivencloud.com:27405/defaultdb?sslMode=REQUIRED
# DB_USERNAME=avnadmin
# DB_PASSWORD=replace-with-the-new-aiven-password
